{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "lib": ["ES2024"],
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "./src",
    "outDir": "./dist",

    "types": ["node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmitOnError": true,
    "verbatimModuleSyntax":true
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
